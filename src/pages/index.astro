---
import Base from '../layouts/Base.astro';
import PubList, { type Pub } from '../components/PubList.astro';
import profile from '../data/profile.json';
import news from '../data/news.json';
import pubs from '../data/publications.json';

const featured = (pubs as Pub[]).filter((p) => p.featured);
---

<Base>
  <section class="hero">
    <img src="/portrait.jpg" alt={profile.name} class="portrait" width="168" height="168" />
    <div>
      <h1>{profile.name}</h1>
      <p class="role">
        {profile.role.title} at <a href={profile.role.url}>{profile.role.org}</a>
      </p>
      <p class="tagline">{profile.tagline}</p>
      <ul class="links">
        <li><a href={profile.links.scholar}>Google Scholar</a></li>
        <li><a href={profile.links.github}>GitHub</a></li>
        <li><a href={profile.links.linkedin}>LinkedIn</a></li>
        <li><a href={profile.links.orcid}>ORCID</a></li>
      </ul>
    </div>
  </section>

  <section class="about">
    {profile.about.map((p) => <p set:html={p} />)}
    <ul class="chips">{profile.interests.map((i) => <li>{i}</li>)}</ul>
  </section>

  <section class="card flexion">
    <div class="card-label">Now</div>
    <h3><a href={profile.role.url}>{profile.role.org}</a></h3>
    <p>{profile.flexion.summary}</p>
    <ul>{profile.flexion.points.map((p) => <li>{p}</li>)}</ul>
  </section>

  <h2>News</h2>
  <ul class="news">
    {
      news.map((n) => (
        <li>
          <span class="date">{n.date}</span>
          <span>
            <span set:html={n.text} />
            {n.url && <> <a href={n.url} aria-label="More">→</a></>}
          </span>
        </li>
      ))
    }
  </ul>

  <h2>Selected publications</h2>
  <PubList pubs={featured} />
  <p class="more"><a href="/publications">All publications →</a></p>

  <div class="two-col">
    <section>
      <h2>Education</h2>
      <ul class="plain">
        {
          profile.education.map((e) => (
            <li>
              <div class="strong">{e.degree}{e.years && <span class="muted"> · {e.years}</span>}</div>
              <div class="muted">{e.org}</div>
            </li>
          ))
        }
      </ul>
    </section>
    <section>
      <h2>Honors</h2>
      <ul class="plain">{profile.honors.map((h) => <li>{h}</li>)}</ul>
    </section>
  </div>
</Base>

<style>
  .hero { display: flex; gap: 36px; align-items: center; padding: 56px 0 12px; }
  .portrait { width: 168px; height: 168px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 1px solid var(--line); }
  h1 { font-size: 2.6rem; margin: 0 0 6px; }
  .role { margin: 0; font-weight: 500; }
  .tagline { margin: 6px 0 14px; color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; padding: 0; margin: 0; font-size: 0.92rem; }

  .about { margin-top: 28px; font-size: 1.04rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 20px 0 0; }
  .chips li { font-size: 0.82rem; padding: 3px 12px; border-radius: 999px; background: var(--surface); color: var(--muted); }

  .card { margin-top: 40px; padding: 24px 28px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); }
  .card-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .card h3 { font-size: 1.45rem; margin: 4px 0 6px; }
  .card h3 a { color: var(--text); }
  .card p { margin: 0 0 8px; }
  .card ul { margin: 0; padding-left: 18px; color: var(--muted); }

  .news { list-style: none; padding: 0; margin: 0; }
  .news li { display: grid; grid-template-columns: 84px 1fr; gap: 16px; padding: 7px 0; }
  .date { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.92rem; padding-top: 1px; }

  .more { margin-top: 14px; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .strong { font-weight: 500; }
  .muted { color: var(--muted); font-size: 0.92rem; }

  @media (max-width: 640px) {
    .hero { flex-direction: column; align-items: flex-start; gap: 20px; padding-top: 36px; }
    .portrait { width: 120px; height: 120px; }
    h1 { font-size: 2.1rem; }
    .two-col { grid-template-columns: 1fr; gap: 0; }
    .news li { grid-template-columns: 1fr; gap: 0; }
    .card { padding: 20px; }
  }
</style>
