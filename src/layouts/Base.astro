---
import profile from '../data/profile.json';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'About' },
  { href: '/publications', label: 'Publications' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/portrait.jpg', Astro.site)} />
    <meta property="og:type" content="profile" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        url: Astro.site?.href,
        image: new URL('/portrait.jpg', Astro.site).href,
        jobTitle: profile.role.title,
        worksFor: { '@type': 'Organization', name: profile.role.org, url: profile.role.url },
        alumniOf: 'ETH Zurich',
        sameAs: [profile.links.scholar, profile.links.orcid, profile.links.github, profile.links.linkedin],
      })}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand">{profile.name}</a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span class="footer-links">
        <a href={profile.links.scholar}>Scholar</a>
        <a href={profile.links.github}>GitHub</a>
        <a href={profile.links.linkedin}>LinkedIn</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --surface: #f2f0ea;
    --text: #1c1b19;
    --muted: #66635c;
    --line: #e2dfd6;
    --accent: #1f5f8b;
    --accent-soft: #e3edf4;
    --serif: 'Newsreader', Georgia, serif;
    --sans: 'Inter', system-ui, -apple-system, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141413;
      --surface: #1d1d1b;
      --text: #ecebe6;
      --muted: #a3a097;
      --line: #2e2d2a;
      --accent: #7fb6dc;
      --accent-soft: #1d2c37;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; }
  h2 { font-size: 1.6rem; margin: 3.5rem 0 1.25rem; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 20px; }

  .site-header { border-bottom: 1px solid var(--line); position: sticky; top: 0; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); z-index: 10; }
  .header-inner { display: flex; justify-content: space-between; align-items: center; height: 60px; gap: 16px; }
  .brand { font-family: var(--serif); font-size: 1.2rem; color: var(--text); }
  .brand:hover { text-decoration: none; }
  nav { display: flex; gap: 22px; }
  nav a { color: var(--muted); font-size: 0.95rem; }
  nav a[aria-current='page'], nav a:hover { color: var(--text); text-decoration: none; }

  .site-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 28px; padding-bottom: 40px; margin-top: 72px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.875rem; }
  .footer-links { display: flex; gap: 18px; }
  .footer-links a { color: var(--muted); }
</style>
